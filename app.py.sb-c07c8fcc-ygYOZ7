<!DOCTYPE html>

<html>

<head>

    <title>Health Dashboard</title>

    <style>

        body{
            background-color: #f0f4f8;
            font-family: Arial;
            text-align: center;
            padding-top: 50px;
        }

        h1{
            color: #0077ff;
        }

        .card{
            background: white;
            width: 300px;
            margin: 20px auto;
            padding: 20px;
            border-radius: 15px;

            box-shadow: 0px 0px 10px gray;
        }

        h2{
            color: #333;
        }

    </style>

</head>

<body>

    <h1>❤️ Smart Health Monitoring Dashboard</h1>

    <div class="card">

        <h2>Heart Rate ❤️</h2>

        <h2>72 BPM</h2>

    </div>

    <div class="card">

        <h2>Temperature 🌡️</h2>

        <h2>36.8 °C</h2>

    </div>

</body>

</html>